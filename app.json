{
  "expo": {
    "name": "Waikīkī Walks",
    "slug": "waikiki-walks",
    "scheme": "waikikiwalks",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.streicherneurology.waikikiwalks",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.streicherneurology.waikikiwalks",
      "adaptiveIcon": {
        "backgroundColor": "#0E6E74",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waikīkī Walks uses your location to show where you are on the walk and to tell you when you have arrived at each stop.",
          "locationAlwaysAndWhenInUsePermission": "Allow location in the background so the walk can tell you when you arrive at a stop, even with your phone in your pocket.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Point your camera at a landmark and Waikīkī Walks will tell you what you are looking at."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E6E74"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-live-activity"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
